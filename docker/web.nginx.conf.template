server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback — the router (added M9) handles unknown paths client-side.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy to the API — activated now that real endpoints exist (M1+).
    # The frontend calls same-origin /api/v1/... so there is no CORS
    # configuration to maintain on the API at all; this is the only thing that
    # ever needs to know the api container's address.
    #
    # API_UPSTREAM is substituted at container start (nginx's built-in
    # envsubst-on-templates entrypoint step) so the same image works unchanged
    # both under docker-compose (API_UPSTREAM=api:3000, the container DNS name)
    # and on a host without compose networking, e.g. Railway, where each
    # service gets its own private hostname (API_UPSTREAM=api.railway.internal:3000).
    #
    # A plain (non-variable) proxy_pass: nginx resolves this once at config
    # load, which is fine as long as api is already reachable by the time web
    # starts (true in practice here — api is a stable, already-running service
    # by the time web (re)deploys). A variable + `resolver 127.0.0.11` form was
    # tried instead (to re-resolve lazily per request, avoiding the config-load
    # requirement), but nginx's resolver queries against the Docker embedded
    # DNS hung indefinitely on this host rather than erroring — confirmed via
    # direct wget from inside the container: proxying to api.railway.internal
    # through nginx hung, while curl/wget straight to the same address from the
    # same container succeeded instantly. Reverted to the simpler form rather
    # than chase that further.
    location /api/ {
        proxy_pass http://${API_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

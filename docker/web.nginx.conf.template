server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback — the router (added M9) handles unknown paths client-side.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy to the API — activated now that real endpoints exist (M1+).
    # The frontend calls same-origin /api/v1/... so there is no CORS
    # configuration to maintain on the API at all; this is the only thing that
    # ever needs to know the api container's address.
    #
    # API_UPSTREAM is substituted at container start (nginx's built-in
    # envsubst-on-templates entrypoint step) so the same image works unchanged
    # both under docker-compose (API_UPSTREAM=api:3000, the container DNS name)
    # and on a host without compose networking, e.g. Railway, where each
    # service gets its own private hostname (API_UPSTREAM=api.railway.internal:3000).
    #
    # Resolved through a variable (not a bare proxy_pass host) with an explicit
    # `resolver`: nginx otherwise resolves proxy_pass hostnames once at config
    # load and refuses to start if the name doesn't resolve yet — fatal here
    # since nothing guarantees the api service is already up (or keeps the same
    # address across restarts) before web starts. The Docker embedded DNS at
    # 127.0.0.11 is what resolves both the compose service name and Railway's
    # private-network hostname.
    resolver 127.0.0.11 valid=10s;
    location /api/ {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass http://$api_upstream/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Every variable below is documented: purpose, required/optional, default.
# Never commit a real value here — only placeholders. See docs/09-SECURITY-RULES.md §1.
# Copy this file to `.env` (git-ignored) and fill in real generated values before
# running `docker compose up -d`.

# --- General ---
NODE_ENV=development            # required. development | test | production

# --- API (apps/api) ---
API_PORT=3000                   # optional, default 3000 (container-internal port)
API_HOST_PORT=3000              # optional, default 3000. The port exposed on the
                                 # HOST machine (docker-compose.yml) — change this if
                                 # another project on the same dev machine already
                                 # uses 3000. Container-internal port stays 3000
                                 # regardless.

# --- Database (packages/db) ---
# TWO separate roles, deliberately not the same one — a table owner always retains
# full DML rights regardless of REVOKE, so audit_log's append-only guarantee
# (CLAUDE.md §1 invariant #8) needs the runtime role to genuinely not be the owner.
# See docs/adr/0002-drop-saas-single-purchase-per-customer-deployment.md.
DB_NAME=erp

# The schema-owning role. Used by Postgres itself (docker-compose.yml `db` service)
# AND by MIGRATE_DATABASE_URL below — the password MUST match in both places.
MIGRATE_DB_USER=erp_migrator
MIGRATE_DB_PASSWORD=            # required. Generate a real secret, don't reuse it.
MIGRATE_DATABASE_URL=postgresql://erp_migrator:CHANGE_ME_SAME_AS_MIGRATE_DB_PASSWORD@db:5432/erp

# The restricted runtime role apps/api and the worker connect as. No UPDATE/DELETE
# grant on audit_log (see the M1 migration). Its password is NOT set by Postgres's
# own init — `npm run migrate:deploy --workspace=@erp/db` syncs it from this URL via
# packages/db/scripts/sync-app-role-password.mjs every time migrations run.
DATABASE_URL=postgresql://erp_app:CHANGE_ME_GENERATE_A_SECRET@db:5432/erp

# --- Redis / job queue ---
REDIS_URL=redis://redis:6379    # required. Used by BullMQ (apps/api worker process)

# --- Auth (M1) ---
# Only the access token is a signed JWT. The refresh token is an opaque random
# value, stored hashed (docs/09-SECURITY-RULES.md §2 "stored hashed") — it has no
# secret of its own to configure.
JWT_ACCESS_SECRET=               # required. Generate per deployment, never reused.

# --- Activation Service client (M1 client / M8 server) ---
ACTIVATION_SERVICE_URL=          # optional. URL of Osama's central Activation Service.
                                  # If unset, this deployment runs in UNCONFIGURED
                                  # license state (permissive, logged) — see
                                  # docs/01-OPEN-DECISIONS.md A5.
LICENSE_MASTER_KEY=              # required once ACTIVATION_SERVICE_URL is set. Issued
                                  # once per customer deployment at install time.
                                  # Never logged, never returned by any API.

# --- Install runbook seed (M1) ---
SEED_ADMIN_EMAIL=                # required to run the seed script. The first admin
                                  # account's email — never hard-coded.
SEED_ADMIN_PASSWORD=             # required to run the seed script. Never committed;
                                  # the seed script refuses to run with a placeholder.

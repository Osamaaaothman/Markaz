# Every variable below is documented: purpose, required/optional, default.
# Never commit a real value here — only placeholders. See docs/09-SECURITY-RULES.md §1.

# --- General ---
NODE_ENV=development            # required. development | test | production

# --- API (apps/api) ---
API_PORT=3000                   # optional, default 3000

# --- Database (packages/db) ---
# required. This deployment's own isolated PostgreSQL instance — never shared
# with another customer. See docs/adr/0002-drop-saas-single-purchase-per-customer-deployment.md
DATABASE_URL=postgresql://erp:erp@db:5432/erp

# --- Redis / job queue ---
REDIS_URL=redis://redis:6379    # required. Used by BullMQ (apps/api worker process)

# --- Auth (added in M1) ---
# JWT_ACCESS_SECRET=            # required in M1. Generate per deployment, never reused.
# JWT_REFRESH_SECRET=           # required in M1. Must differ from JWT_ACCESS_SECRET.

# --- Activation Service client (added in M1/M8) ---
# ACTIVATION_SERVICE_URL=       # required. URL of Osama's central Activation Service.
# LICENSE_MASTER_KEY=           # required. Issued once per customer deployment at
                                 # install time. Never logged, never returned by any API.

// Prisma schema for the ERP API.
// Foundation phase: auth (User/Role/Permission). More models land per module.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// No `url` here by design: Prisma 7 connects via a driver adapter
// (@prisma/adapter-pg) constructed with DATABASE_URL at runtime, not
// through the schema file. prisma.config.ts still supplies the URL
// for the CLI (migrate/studio).
datasource db {
  provider = "postgresql"
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  /// Module/action pair, e.g. "inventory:read", "purchasing:approve".
  action      String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  isActive      Boolean        @default(true)
  roleId        String?
  role          Role?          @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  /// Soft delete -- never hard-delete user records.
  deletedAt     DateTime?
}

model RefreshToken {
  id        String    @id @default(cuid())
  /// Only the hash is stored -- the raw token is only ever seen by the client.
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

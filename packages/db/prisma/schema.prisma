// M1: identity, permissions, audit, and license-check state.
// M2: currencies, chart of accounts, fiscal years/periods, journal entries, numbering.
// Conventions: docs/04-DATA-MODEL-RULES.md. Ledger integrity: docs/05-ACCOUNTING-INTEGRITY-RULES.md.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows/macOS) and CI. "debian-openssl-3.0.x" is
  // needed because the Docker build stage (node:22-alpine, musl) and the runtime
  // stage (node:22-bookworm-slim, glibc — switched in M3 for Playwright, which
  // does not run on musl) are different OSes: the engine binary generated during
  // build must work when the runtime stage actually executes it.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per customer-run legal entity within this single deployment (docs/00-PRODUCT-BRIEF.md
// §4 note: "per tenant" here means per company/branch within one customer's own
// deployment, not a cross-customer SaaS tenant).
model Company {
  id              String   @id
  name            String
  defaultCurrency String   @default("SAR") @map("default_currency")
  timezone        String   @default("Asia/Riyadh")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by")
  updatedBy       String?  @map("updated_by")
  version         Int      @default(1)

  users User[]
  roles Role[]

  fiscalYears      FiscalYear[]
  fiscalPeriods    FiscalPeriod[]
  accounts         Account[]
  parties          Party[]
  journalEntries   JournalEntry[]
  exchangeRates    ExchangeRate[]
  outboxMessages   OutboxMessage[]
  approvalPolicies ApprovalPolicy[]
  approvalRequests ApprovalRequest[]

  // M4 inventory
  accountMappings    AccountMapping[]
  warehouses         Warehouse[]
  items              Item[]
  itemWarehouseStock ItemWarehouseStock[]
  stockMovements     StockMovement[]
  costLayers         CostLayer[]
  goodsReceipts      GoodsReceipt[]
  stockIssues        StockIssue[]
  stockCounts        StockCount[]

  // M5 purchasing
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  taxCodes         TaxCode[]
  supplierInvoices SupplierInvoice[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  salesInvoices    SalesInvoice[]

  @@map("companies")
}

model User {
  id                  String    @id
  companyId           String    @map("company_id")
  // Human-readable label (USR-000012), unique per company; the UUID `id` stays the key.
  ref                 String
  email               String    @unique
  passwordHash        String    @map("password_hash")
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdBy           String?   @map("created_by")
  updatedBy           String?   @map("updated_by")
  version             Int       @default(1)

  company       Company        @relation(fields: [companyId], references: [id])
  roles         UserRole[]
  refreshTokens RefreshToken[]

  @@unique([companyId, ref])
  @@index([companyId])
  @@map("users")
}

// Roles are per-company configuration, not a fixed global list — docs/03-MULTI-TENANCY-RULES.md §7:
// everything a customer can differ on is data, never a code branch.
model Role {
  id        String   @id
  companyId String   @map("company_id")
  // Human-readable label (ROL-000003), unique per company; the UUID `id` stays the key.
  ref       String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, name])
  @@unique([companyId, ref])
  @@map("roles")
}

// Permissions are a fixed catalog defined by the application (what actions exist),
// not per-company data — which roles grant them (RolePermission) is what's configurable.
model Permission {
  id          String  @id
  code        String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

// Refresh token rotation with reuse detection — docs/09-SECURITY-RULES.md §2.
// Stored hashed, never the raw token.
model RefreshToken {
  id                String    @id
  userId            String    @map("user_id")
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// Append-only — docs/02-ARCHITECTURE-RULES.md §3.4. No update path, no delete path
// exists in application code, and the application DB role has no UPDATE/DELETE grant
// on this table (docs/05-ACCOUNTING-INTEGRITY-RULES.md §9) — enforced in the M1
// migration, not only by convention.
model AuditLog {
  id            String   @id
  companyId     String?  @map("company_id")
  actorId       String   @map("actor_id")
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  beforeJson    Json?    @map("before_json")
  afterJson     Json?    @map("after_json")
  correlationId String   @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")

  @@index([companyId])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// Single-row table: this deployment's own view of its license check-in status
// against the central Activation Service. The master key itself is NOT stored here —
// it stays in the environment/secret store (docs/09-SECURITY-RULES.md §1) and is
// read fresh at check-in time. This table only tracks outcomes.
model LicenseState {
  id                      String    @id @default("singleton")
  status                  String    @default("UNCONFIGURED")
  lastSuccessfulCheckinAt DateTime? @map("last_successful_checkin_at")
  lastAttemptAt           DateTime? @map("last_attempt_at")
  seatsAllowed            Int?      @map("seats_allowed")
  seatsUsed               Int?      @map("seats_used")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@map("license_state")
}

// ============================================================================
// M2 — Accounting core
// ============================================================================

// Fixed catalog, not per-company data — which currencies a company actually USES
// is a company-level concern expressed via Company.defaultCurrency and whichever
// currencies appear on its ExchangeRate/JournalEntry rows, not by restricting this
// table itself.
model Currency {
  code            String   @id // ISO 4217, e.g. "SAR"
  name            String
  minorUnitDigits Int      @default(2) @map("minor_unit_digits")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  exchangeRates ExchangeRate[]

  @@map("currencies")
}

// A snapshot of a rate on a given date — never mutated once written. A journal
// entry in a foreign currency stores the rate it actually used (JournalEntry.exchangeRate),
// not a live reference to this table, per docs/04-DATA-MODEL-RULES.md §2: "The base
// amount is stored, not recomputed later — historical rates must not shift because a
// rate table was updated."
model ExchangeRate {
  id        String   @id
  companyId String   @map("company_id")
  currency  String
  rateDate  DateTime @map("rate_date") @db.Date
  rate      Decimal  @db.Decimal(19, 6) // units of base currency per 1 unit of `currency`
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  company      Company  @relation(fields: [companyId], references: [id])
  currencyInfo Currency @relation(fields: [currency], references: [code])

  @@unique([companyId, currency, rateDate])
  @@map("exchange_rates")
}

model FiscalYear {
  id        String   @id
  companyId String   @map("company_id")
  name      String // e.g. "FY2026"
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  status    String   @default("OPEN") // OPEN | CLOSED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company        @relation(fields: [companyId], references: [id])
  periods FiscalPeriod[]

  @@unique([companyId, name])
  @@map("fiscal_years")
}

// docs/05-ACCOUNTING-INTEGRITY-RULES.md §3: "Periods have states: OPEN → CLOSED →
// (optionally) LOCKED. No posting into a closed period. Enforced at the database
// level, not only in a service." See the closed-period trigger in the M2 migration.
model FiscalPeriod {
  id           String   @id
  companyId    String   @map("company_id")
  fiscalYearId String   @map("fiscal_year_id")
  periodNumber Int      @map("period_number") // 1-12, Tier 1 assumes monthly periods (docs/01-OPEN-DECISIONS.md B7)
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  status       String   @default("OPEN") // OPEN | CLOSED | LOCKED
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company        Company        @relation(fields: [companyId], references: [id])
  fiscalYear     FiscalYear     @relation(fields: [fiscalYearId], references: [id])
  journalEntries JournalEntry[]

  @@unique([companyId, fiscalYearId, periodNumber])
  @@index([companyId, startDate, endDate])
  @@map("fiscal_periods")
}

// Tree-structured chart of accounts — docs/05-ACCOUNTING-INTEGRITY-RULES.md §4.
// Only leaf accounts are postable (isPostable); an account with postings is
// deactivated, never deleted or retyped — enforced by application code (no delete
// method exists) since "has this account ever been posted to" is a runtime fact a
// CHECK constraint cannot express.
model Account {
  id            String   @id
  companyId     String   @map("company_id")
  // Human-readable label (ACC-000217), unique per company; `code` stays the accounting identifier.
  ref           String
  code          String
  name          String
  nameAr        String?  @map("name_ar") // Arabic display name; the English `name` stays the fallback
  type          String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  normalBalance String   @map("normal_balance") // DEBIT | CREDIT
  parentId      String?  @map("parent_id")
  isPostable    Boolean  @default(true) @map("is_postable")
  isActive      Boolean  @default(true) @map("is_active")
  // The party (person, company, employee...) this account is kept for, if any. Many accounts
  // may point at one party — a subcontractor has several in the chart.
  partyId       String?  @map("party_id")
  // #RRGGBB, chosen for a top-level account only; its whole branch is drawn in this colour.
  color         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String?  @map("created_by")
  updatedBy     String?  @map("updated_by")
  version       Int      @default(1)

  company              Company               @relation(fields: [companyId], references: [id])
  parent               Account?              @relation("AccountTree", fields: [parentId], references: [id])
  children             Account[]             @relation("AccountTree")
  party                Party?                @relation(fields: [partyId], references: [id], onDelete: Restrict)
  journalEntryLines    JournalEntryLine[]
  // M4 inventory: an account may be the target of a mapping key (INVENTORY, GRNI, ...).
  accountMappings      AccountMapping[]
  supplierInvoiceLines SupplierInvoiceLine[]

  @@unique([companyId, code])
  @@unique([companyId, ref])
  @@index([companyId, parentId])
  @@index([companyId, partyId])
  @@map("accounts")
}

// A person, company or employee an account can be kept for (custodian, supplier, customer...).
// Master data, deactivated rather than deleted once referenced.
model Party {
  id        String   @id
  companyId String   @map("company_id")
  // Human-readable label (PRT-000041), unique per company; the UUID `id` stays the key.
  ref       String
  name      String
  nameAr    String?  @map("name_ar")
  kind      String // COMPANY | PERSON | EMPLOYEE | OTHER
  phone     String?
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  company          Company           @relation(fields: [companyId], references: [id])
  accounts         Account[]
  // M4 inventory: the supplier a goods receipt was received from, if recorded.
  goodsReceipts    GoodsReceipt[]
  // M5 purchasing: orders placed with this party as the supplier.
  purchaseOrders   PurchaseOrder[]
  supplierInvoices SupplierInvoice[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  salesInvoices    SalesInvoice[]

  @@unique([companyId, ref])
  @@index([companyId, kind])
  @@index([companyId, name])
  @@map("parties")
}

// Gapless, transactional numbering — docs/02-ARCHITECTURE-RULES.md §3.3. Allocation
// happens inside the caller's transaction via a row lock (SELECT ... FOR UPDATE) on
// this row, so a rollback never burns a number and two concurrent requests can't
// collide. One row per (company, document type, fiscal year).
model DocumentNumberSeries {
  id           String   @id
  companyId    String   @map("company_id")
  documentType String   @map("document_type")
  fiscalYear   String   @map("fiscal_year")
  prefix       String   @default("")
  padding      Int      @default(6)
  lastNumber   Int      @default(0) @map("last_number")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([companyId, documentType, fiscalYear])
  @@map("document_number_series")
}

// Posted entries are immutable — docs/05-ACCOUNTING-INTEGRITY-RULES.md §2: "A posted
// journal entry is never updated and never deleted. If you find yourself writing an
// UPDATE against journal_entries or journal_entry_lines, stop." Corrections are
// reversing entries (reversalOfEntryId points backward on the NEW entry — the
// original is never touched). Enforced at the database role level too (no
// UPDATE/DELETE grant for erp_app — see the M2 migration), the same pattern already
// proven for audit_log in M1.
model JournalEntry {
  id                 String   @id
  companyId          String   @map("company_id")
  fiscalPeriodId     String   @map("fiscal_period_id")
  number             String // allocated via INumberingService, in the same transaction
  entryDate          DateTime @map("entry_date") @db.Date
  postingDate        DateTime @map("posting_date") @db.Date
  currency           String
  exchangeRate       Decimal? @map("exchange_rate") @db.Decimal(19, 6) // null/omitted when currency == company base currency
  sourceModule       String   @map("source_module")
  sourceDocumentType String   @map("source_document_type")
  sourceDocumentId   String   @map("source_document_id")
  actorId            String   @map("actor_id")
  correlationId      String   @map("correlation_id")
  idempotencyKey     String   @map("idempotency_key")
  reversalOfEntryId  String?  @map("reversal_of_entry_id")
  createdAt          DateTime @default(now()) @map("created_at")

  company          Company            @relation(fields: [companyId], references: [id])
  fiscalPeriod     FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id])
  lines            JournalEntryLine[]
  reversalOf       JournalEntry?      @relation("Reversal", fields: [reversalOfEntryId], references: [id])
  reversedBy       JournalEntry[]     @relation("Reversal")
  // M4 inventory: the entry a stock movement / goods receipt / stock issue / stock count
  // line was posted by.
  stockMovements   StockMovement[]
  goodsReceipts    GoodsReceipt[]
  stockIssues      StockIssue[]
  stockCountLines  StockCountLine[]
  supplierInvoices SupplierInvoice[]
  salesInvoices    SalesInvoice[]

  // The idempotencyKey unique constraint below IS the duplicate-posting guard
  // (docs/04-DATA-MODEL-RULES.md §6/§9) — a separate uniqueness constraint on the
  // source-document columns was considered and dropped: Postgres treats NULL as
  // distinct in unique constraints, so it would not have actually blocked duplicate
  // original postings (reversalOfEntryId is NULL for all of them). Idempotency-Key
  // is the correct, working mechanism for this.
  @@unique([companyId, idempotencyKey])
  @@index([companyId, fiscalPeriodId])
  @@index([companyId, number])
  @@index([companyId, sourceModule, sourceDocumentType, sourceDocumentId])
  @@map("journal_entries")
}

// docs/04-DATA-MODEL-RULES.md §9: exactly one of debit/credit populated, both
// non-negative — enforced by a CHECK constraint (M2 migration), not just this
// field shape. baseDebit/baseCredit are the company-base-currency equivalents,
// computed once at posting time from the entry's exchangeRate and stored — never
// recomputed later (docs/04 §2).
model JournalEntryLine {
  id             String  @id
  journalEntryId String  @map("journal_entry_id")
  accountId      String  @map("account_id")
  debit          Decimal @default(0) @db.Decimal(19, 4)
  credit         Decimal @default(0) @db.Decimal(19, 4)
  baseDebit      Decimal @default(0) @map("base_debit") @db.Decimal(19, 4)
  baseCredit     Decimal @default(0) @map("base_credit") @db.Decimal(19, 4)
  description    String?
  lineNumber     Int     @map("line_number")

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

// M3: the transactional outbox (docs/06-COMPLIANCE-PACK-RULES.md §4,
// docs/02-ARCHITECTURE-RULES.md §6-7, docs/04-DATA-MODEL-RULES.md §10). A row is
// written in the SAME database transaction as the business change it announces —
// never after it. A separate relay job polls PENDING rows and enqueues the matching
// BullMQ job; this is what guarantees the announcement survives a crash between
// commit and dispatch. The outbox never stores retry/failure state for the work
// itself — once dispatched, BullMQ's own attempts/backoff/dead-letter handling
// (apps/api/src/jobs) takes over.
model OutboxMessage {
  id            String    @id
  companyId     String    @map("company_id")
  // Logical event name, past tense (docs/02 §7), e.g. "invoice.issued" — maps to a
  // BullMQ queue name at relay time. Never a whole entity as the payload.
  topic         String
  payload       Json
  correlationId String    @map("correlation_id")
  dispatchedAt  DateTime? @map("dispatched_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  // Relay polls WHERE dispatchedAt IS NULL ORDER BY createdAt — this index serves
  // exactly that query, not one-index-per-column.
  @@index([dispatchedAt, createdAt])
  @@index([companyId])
  @@map("outbox_messages")
}

// M3: the approval workflow engine — docs/01-OPEN-DECISIONS.md B6: "Tier 1 assumes
// the simpler version" (single-step amount threshold, not a multi-step configurable
// engine). One row per (company, subject type) the company has opted into requiring
// approval for; no row means that document type never requires approval.
model ApprovalPolicy {
  id              String   @id
  companyId       String   @map("company_id")
  // A future module's document type, e.g. "purchase_order" — never enforced by an
  // enum here, since Core does not know which modules exist (docs/02-ARCHITECTURE-RULES.md).
  subjectType     String   @map("subject_type")
  thresholdAmount Decimal  @map("threshold_amount") @db.Decimal(19, 4)
  currency        String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, subjectType])
  @@map("approval_policies")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// One row per document that actually crossed its policy's threshold. Terminal once
// decided (docs/02 §... same immutability spirit as journal entries: a decision is
// not re-editable — a changed mind means a new request, e.g. after the underlying
// document itself changes and is resubmitted).
model ApprovalRequest {
  id            String         @id
  companyId     String         @map("company_id")
  subjectType   String         @map("subject_type")
  subjectId     String         @map("subject_id")
  amount        Decimal        @db.Decimal(19, 4)
  currency      String
  status        ApprovalStatus @default(PENDING)
  requestedBy   String         @map("requested_by")
  decidedBy     String?        @map("decided_by")
  decidedAt     DateTime?      @map("decided_at")
  reason        String?
  correlationId String         @map("correlation_id")
  createdAt     DateTime       @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  // One live approval request per document — re-requesting for the same subject
  // returns the existing row instead of creating a duplicate (approval.service.ts).
  @@unique([companyId, subjectType, subjectId])
  @@index([companyId, status])
  @@map("approval_requests")
}

// ─── M4: Inventory ──────────────────────────────────────────────────────────────
// docs/14-MILESTONES.md M4. Valuation: weighted average (docs/01-OPEN-DECISIONS.md A3,
// decided 2026-09). A module never writes journal entries itself (docs/02 §3.1) — every
// posting command here goes through IAccountingEngine.postEntry inside the same
// transaction as the stock movement, using the account each key below maps to.
model AccountMapping {
  id        String   @id
  companyId String   @map("company_id")
  // INVENTORY | GRNI | PROJECT_ISSUE_EXPENSE | COUNT_LOSS | COUNT_GAIN — what the amount
  // means, not which account; the account is tenant configuration (docs/05 §4).
  key       String
  accountId String   @map("account_id")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  company Company @relation(fields: [companyId], references: [id])
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([companyId, key])
  @@map("account_mappings")
}

model Warehouse {
  id        String   @id
  companyId String   @map("company_id")
  ref       String
  code      String
  name      String
  nameAr    String?  @map("name_ar")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  company           Company              @relation(fields: [companyId], references: [id])
  stock             ItemWarehouseStock[]
  stockMovements    StockMovement[]
  costLayers        CostLayer[]
  goodsReceipts     GoodsReceipt[]
  stockIssues       StockIssue[]
  stockCounts       StockCount[]
  salesInvoiceLines SalesInvoiceLine[]

  @@unique([companyId, code])
  @@unique([companyId, ref])
  @@map("warehouses")
}

model Item {
  id           String   @id
  companyId    String   @map("company_id")
  ref          String
  code         String
  name         String
  nameAr       String?  @map("name_ar")
  unit         String
  // Below this on-hand quantity, the item shows on the reorder list (docs/14 M4). No
  // per-warehouse override in M4 — one point per item, company-wide.
  reorderPoint Decimal  @default(0) @map("reorder_point") @db.Decimal(19, 4)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    String?  @map("created_by")
  updatedBy    String?  @map("updated_by")
  version      Int      @default(1)

  company              Company               @relation(fields: [companyId], references: [id])
  stock                ItemWarehouseStock[]
  stockMovements       StockMovement[]
  costLayers           CostLayer[]
  goodsReceiptLines    GoodsReceiptLine[]
  stockIssueLines      StockIssueLine[]
  stockCountLines      StockCountLine[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  quotationLines       QuotationLine[]
  salesOrderLines      SalesOrderLine[]
  salesInvoiceLines    SalesInvoiceLine[]

  @@unique([companyId, code])
  @@unique([companyId, ref])
  @@map("items")
}

// Current on-hand quantity and its total cost per item+warehouse — the weighted-average
// source of truth. `value / quantity` is the average unit cost; it is never stored as its
// own rounded figure (packages/core/src/inventory/weighted-average.util.ts), so repeated
// receipts and issues never drift from the control account by accumulated rounding.
// Updated in place, inside the same transaction as the stock movement that causes the
// change — the CHECKs below are the database's own backstop against a negative issue or a
// negative balance, not just an application-level check (docs/05 §9 principle).
model ItemWarehouseStock {
  id          String   @id
  companyId   String   @map("company_id")
  itemId      String   @map("item_id")
  warehouseId String   @map("warehouse_id")
  quantity    Decimal  @default(0) @db.Decimal(19, 4)
  value       Decimal  @default(0) @db.Decimal(19, 4)
  updatedAt   DateTime @updatedAt @map("updated_at")
  version     Int      @default(1)

  company   Company   @relation(fields: [companyId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([itemId, warehouseId])
  @@index([companyId])
  @@map("item_warehouse_stock")
}

// Append-only, like journal_entry_lines — a correction is a new movement, never an edit
// (docs/05 §2 principle extended to stock). `quantity` is signed: positive for a receipt or
// a count surplus, negative for an issue or a count shortage. `journalEntryId` is always set:
// every movement in M4 has a financial effect and is posted in the same transaction that
// writes this row (docs/02 §5).
model StockMovement {
  id                 String   @id
  companyId          String   @map("company_id")
  itemId             String   @map("item_id")
  warehouseId        String   @map("warehouse_id")
  // RECEIPT | ISSUE | COUNT_ADJUSTMENT
  movementType       String   @map("movement_type")
  quantity           Decimal  @db.Decimal(19, 4)
  unitCost           Decimal  @map("unit_cost") @db.Decimal(19, 4)
  value              Decimal  @db.Decimal(19, 4)
  sourceDocumentType String   @map("source_document_type")
  sourceDocumentId   String   @map("source_document_id")
  journalEntryId     String   @map("journal_entry_id")
  actorId            String   @map("actor_id")
  correlationId      String   @map("correlation_id")
  createdAt          DateTime @default(now()) @map("created_at")

  company      Company      @relation(fields: [companyId], references: [id])
  item         Item         @relation(fields: [itemId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])

  @@index([companyId, itemId, warehouseId])
  @@index([companyId, sourceDocumentType, sourceDocumentId])
  @@map("stock_movements")
}

// One row per receipt line, kept but not read for costing in M4 (weighted average pools
// everything into item_warehouse_stock) — the table exists so a future FIFO tenant setting
// (docs/01-OPEN-DECISIONS.md A3: "design the schema so both are possible") has real layers
// to read instead of a schema migration. `quantityRemaining` starts equal to the received
// quantity; nothing in M4 decrements it.
model CostLayer {
  id                String   @id
  companyId         String   @map("company_id")
  itemId            String   @map("item_id")
  warehouseId       String   @map("warehouse_id")
  receivedAt        DateTime @map("received_at")
  quantityReceived  Decimal  @map("quantity_received") @db.Decimal(19, 4)
  quantityRemaining Decimal  @map("quantity_remaining") @db.Decimal(19, 4)
  unitCost          Decimal  @map("unit_cost") @db.Decimal(19, 4)
  sourceDocumentId  String   @map("source_document_id")
  createdAt         DateTime @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([companyId, itemId, warehouseId])
  @@map("cost_layers")
}

// A receipt not yet matched to a supplier invoice posts Inventory / GRNI (goods-received-
// not-invoiced) — docs/14 M4. No PO link in M4 (purchasing is M5); `partyId` is the supplier,
// optional because a tenant may not have parties set up for every source yet. Immutable once
// posted, like a journal entry — a correction is a new document, never an edit.
model GoodsReceipt {
  id              String   @id
  companyId       String   @map("company_id")
  number          String
  warehouseId     String   @map("warehouse_id")
  partyId         String?  @map("party_id")
  // M5: the purchase order this receipt was booked against, if any (null = a direct receipt).
  purchaseOrderId String?  @map("purchase_order_id")
  documentDate    DateTime @map("document_date") @db.Date
  reference       String?
  journalEntryId  String   @map("journal_entry_id")
  actorId         String   @map("actor_id")
  correlationId   String   @map("correlation_id")
  createdAt       DateTime @default(now()) @map("created_at")

  company       Company            @relation(fields: [companyId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  party         Party?             @relation(fields: [partyId], references: [id], onDelete: Restrict)
  journalEntry  JournalEntry       @relation(fields: [journalEntryId], references: [id])
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  lines         GoodsReceiptLine[]

  @@unique([companyId, number])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String  @id
  goodsReceiptId      String  @map("goods_receipt_id")
  itemId              String  @map("item_id")
  quantity            Decimal @db.Decimal(19, 4)
  unitCost            Decimal @map("unit_cost") @db.Decimal(19, 4)
  value               Decimal @db.Decimal(19, 4)
  lineNumber          Int     @map("line_number")
  // M5: the order line this quantity was received against, if any.
  purchaseOrderLineId String? @map("purchase_order_line_id")

  goodsReceipt      GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id])
  item              Item               @relation(fields: [itemId], references: [id])
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@map("goods_receipt_lines")
}

// An issue to a project debits direct costs at the item's current weighted-average cost
// (docs/14 M4 decision). `costCenterRef` is free text in M4 — no formal project/cost-center
// module exists yet; it becomes a real link once one does. No negative stock
// (docs/01-OPEN-DECISIONS.md A3 decision): the service rejects a line whose quantity exceeds
// the warehouse's on-hand quantity, and item_warehouse_stock's own CHECK backstops it.
model StockIssue {
  id             String   @id
  companyId      String   @map("company_id")
  number         String
  warehouseId    String   @map("warehouse_id")
  costCenterRef  String   @map("cost_center_ref")
  documentDate   DateTime @map("document_date") @db.Date
  journalEntryId String   @map("journal_entry_id")
  actorId        String   @map("actor_id")
  correlationId  String   @map("correlation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  company      Company          @relation(fields: [companyId], references: [id])
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id])
  journalEntry JournalEntry     @relation(fields: [journalEntryId], references: [id])
  lines        StockIssueLine[]

  @@unique([companyId, number])
  @@map("stock_issues")
}

model StockIssueLine {
  id           String  @id
  stockIssueId String  @map("stock_issue_id")
  itemId       String  @map("item_id")
  quantity     Decimal @db.Decimal(19, 4)
  // The weighted-average unit cost at the moment of posting — stored, never recomputed
  // later (docs/04 §2 principle), so a past issue's cost never drifts.
  unitCost     Decimal @map("unit_cost") @db.Decimal(19, 4)
  value        Decimal @db.Decimal(19, 4)
  lineNumber   Int     @map("line_number")

  stockIssue StockIssue @relation(fields: [stockIssueId], references: [id])
  item       Item       @relation(fields: [itemId], references: [id])

  @@index([stockIssueId])
  @@map("stock_issue_lines")
}

// A physical count compared to the book quantity: a shortage debits COUNT_LOSS, a surplus
// debits Inventory and credits COUNT_GAIN (docs/14 M4 decision — the two accounts Osama
// still needs to confirm with his accountant). `systemQuantity` and `unitCost` are the
// warehouse's figures at the moment the count line was recorded, not read again at posting
// time, so the variance stays reproducible even if other movements happen in between.
model StockCount {
  id            String    @id
  companyId     String    @map("company_id")
  number        String
  warehouseId   String    @map("warehouse_id")
  documentDate  DateTime  @map("document_date") @db.Date
  // Set once the count is posted; a count is entered first (lines added, nothing posted
  // yet) and posted as a single step once all lines are counted.
  postedAt      DateTime? @map("posted_at")
  actorId       String    @map("actor_id")
  correlationId String    @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  company   Company          @relation(fields: [companyId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  lines     StockCountLine[]

  @@unique([companyId, number])
  @@map("stock_counts")
}

model StockCountLine {
  id              String  @id
  stockCountId    String  @map("stock_count_id")
  itemId          String  @map("item_id")
  systemQuantity  Decimal @map("system_quantity") @db.Decimal(19, 4)
  countedQuantity Decimal @map("counted_quantity") @db.Decimal(19, 4)
  unitCost        Decimal @map("unit_cost") @db.Decimal(19, 4)
  // One journal entry line per non-zero-variance item, not one entry per count — a count
  // with 40 items and 3 variances posts one small entry, not forty. Null until the count
  // (and this line) is posted.
  journalEntryId  String? @map("journal_entry_id")
  lineNumber      Int     @map("line_number")

  stockCount   StockCount    @relation(fields: [stockCountId], references: [id])
  item         Item          @relation(fields: [itemId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([stockCountId])
  @@map("stock_count_lines")
}

// ─── M5: Purchasing ─────────────────────────────────────────────────────────────
// docs/14-MILESTONES.md M5. Request -> order -> receipt (the M4 goods receipt, now linked to the
// order) -> supplier invoice. A supplier is simply a Party. Numbers (PRQ-2026-000001,
// PO-2026-000001) come from the gapless document_number_series, allocated in the creating
// transaction like every other document number.

// An internal request to buy, raised by whoever needs the goods. PENDING until a buyer turns it
// into an order (PROCESSED, linked) or turns it down (REJECTED, with a reason).
model PurchaseRequest {
  id              String    @id
  companyId       String    @map("company_id")
  number          String
  status          String // PENDING | PROCESSED | REJECTED
  notes           String?
  rejectionReason String?   @map("rejection_reason")
  requestedBy     String    @map("requested_by")
  decidedBy       String?   @map("decided_by")
  decidedAt       DateTime? @map("decided_at")
  purchaseOrderId String?   @map("purchase_order_id")
  correlationId   String    @map("correlation_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company       Company               @relation(fields: [companyId], references: [id])
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  lines         PurchaseRequestLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                String  @id
  purchaseRequestId String  @map("purchase_request_id")
  itemId            String  @map("item_id")
  quantity          Decimal @db.Decimal(19, 4)
  notes             String?
  lineNumber        Int     @map("line_number")

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  item            Item            @relation(fields: [itemId], references: [id])

  @@index([purchaseRequestId])
  @@map("purchase_request_lines")
}

// An order to one supplier. Above the company approval threshold (approval_policies, subject
// "purchase_order") it waits in PENDING_APPROVAL; otherwise it is APPROVED at creation. Receipts
// move it APPROVED -> PARTIALLY_RECEIVED -> RECEIVED. Lines are never edited after creation: a
// wrong order is cancelled (only while nothing is received) and re-issued.
model PurchaseOrder {
  id                String    @id
  companyId         String    @map("company_id")
  number            String
  supplierId        String    @map("supplier_id")
  status            String // PENDING_APPROVAL | APPROVED | REJECTED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  orderDate         DateTime  @map("order_date") @db.Date
  expectedDate      DateTime? @map("expected_date") @db.Date
  currency          String
  // Sum of quantity x unit price over the lines, before tax (tax is applied on the supplier invoice).
  totalAmount       Decimal   @map("total_amount") @db.Decimal(19, 4)
  notes             String?
  approvalRequestId String?   @map("approval_request_id")
  requestedBy       String    @map("requested_by")
  correlationId     String    @map("correlation_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  version           Int       @default(1)

  company          Company             @relation(fields: [companyId], references: [id])
  supplier         Party               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines            PurchaseOrderLine[]
  purchaseRequests PurchaseRequest[]
  goodsReceipts    GoodsReceipt[]
  supplierInvoices SupplierInvoice[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, supplierId])
  @@map("purchase_orders")
}

// receivedQuantity is the only mutable column here: it moves, under a row lock, in the same
// transaction as the goods receipt that causes it. The database backstops 0 <= received <= ordered.
model PurchaseOrderLine {
  id               String  @id
  purchaseOrderId  String  @map("purchase_order_id")
  itemId           String  @map("item_id")
  quantity         Decimal @db.Decimal(19, 4)
  unitPrice        Decimal @map("unit_price") @db.Decimal(19, 4)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(19, 4)
  // Quantity already matched to supplier invoices; never more than received (CHECK).
  invoicedQuantity Decimal @default(0) @map("invoiced_quantity") @db.Decimal(19, 4)
  lineNumber       Int     @map("line_number")

  purchaseOrder     PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  item              Item                  @relation(fields: [itemId], references: [id])
  goodsReceiptLines GoodsReceiptLine[]
  invoiceLines      SupplierInvoiceLine[]

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

// ─── M5: supplier invoices and tax codes ────────────────────────────────────────
// A tax code is a treatment, not a bare rate (docs/14 M6 "tax treatment codes"): STANDARD carries a
// percentage, the others are always 0 and exist so a report can tell zero-rated from exempt from
// outside the scope. Rate and treatment are copied onto each invoice line when posted.
model TaxCode {
  id        String   @id
  companyId String   @map("company_id")
  code      String
  name      String
  nameAr    String?  @map("name_ar")
  // Percentage, e.g. 15.0000 for 15%.
  rate      Decimal  @db.Decimal(7, 4)
  treatment String // STANDARD | ZERO_RATED | EXEMPT | OUT_OF_SCOPE
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  company           Company               @relation(fields: [companyId], references: [id])
  invoiceLines      SupplierInvoiceLine[]
  quotationLines    QuotationLine[]
  salesOrderLines   SalesOrderLine[]
  salesInvoiceLines SalesInvoiceLine[]

  @@unique([companyId, code])
  @@map("tax_codes")
}

// A posted supplier invoice. Immutable like a journal entry; a correction is a new document.
// Posting: Dr GRNI at the order price for the matched quantity, Dr/Cr purchase price variance for
// the difference, Dr expense for non-stock lines, Dr input VAT, Cr accounts payable for the gross.
model SupplierInvoice {
  id                    String    @id
  companyId             String    @map("company_id")
  number                String
  supplierId            String    @map("supplier_id")
  // The number printed on the supplier's own invoice; unique per supplier so the same bill cannot be entered twice.
  supplierInvoiceNumber String    @map("supplier_invoice_number")
  invoiceDate           DateTime  @map("invoice_date") @db.Date
  dueDate               DateTime? @map("due_date") @db.Date
  currency              String
  totalNet              Decimal   @map("total_net") @db.Decimal(19, 4)
  totalTax              Decimal   @map("total_tax") @db.Decimal(19, 4)
  totalGross            Decimal   @map("total_gross") @db.Decimal(19, 4)
  purchaseOrderId       String?   @map("purchase_order_id")
  journalEntryId        String    @map("journal_entry_id")
  notes                 String?
  actorId               String    @map("actor_id")
  correlationId         String    @map("correlation_id")
  createdAt             DateTime  @default(now()) @map("created_at")

  company       Company               @relation(fields: [companyId], references: [id])
  supplier      Party                 @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  journalEntry  JournalEntry          @relation(fields: [journalEntryId], references: [id])
  lines         SupplierInvoiceLine[]

  @@unique([companyId, number])
  @@unique([companyId, supplierId, supplierInvoiceNumber])
  @@index([companyId, supplierId])
  @@map("supplier_invoices")
}

model SupplierInvoiceLine {
  id                  String  @id
  supplierInvoiceId   String  @map("supplier_invoice_id")
  kind                String // PO_LINE | EXPENSE
  purchaseOrderLineId String? @map("purchase_order_line_id")
  // Expense lines post straight to this account.
  accountId           String? @map("account_id")
  description         String?
  quantity            Decimal @db.Decimal(19, 4)
  unitPrice           Decimal @map("unit_price") @db.Decimal(19, 4)
  netAmount           Decimal @map("net_amount") @db.Decimal(19, 4)
  taxCodeId           String  @map("tax_code_id")
  taxRate             Decimal @map("tax_rate") @db.Decimal(7, 4)
  taxAmount           Decimal @map("tax_amount") @db.Decimal(19, 4)
  // Invoice net minus quantity x the order price; 0 for expense lines.
  priceVariance       Decimal @default(0) @map("price_variance") @db.Decimal(19, 4)
  lineNumber          Int     @map("line_number")

  supplierInvoice   SupplierInvoice    @relation(fields: [supplierInvoiceId], references: [id])
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  account           Account?           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  taxCode           TaxCode            @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)

  @@index([supplierInvoiceId])
  @@map("supplier_invoice_lines")
}

// ─── M6: Sales ──────────────────────────────────────────────────────────────────
// docs/14-MILESTONES.md M6. Quotation -> sales order -> invoice, one linked chain. A customer is a
// Party. VAT goes through tax codes (treatments), never a bare rate. An invoice posts revenue, output
// VAT and the receivable, and for stock items the cost of goods sold against Inventory at the item's
// weighted-average cost. This module is country-agnostic: nothing here is ZATCA-specific
// (docs/06 / CLAUDE.md invariant 6) — e-invoicing hangs off the posted invoice later.

// An offer to a customer. OPEN until it is turned into a sales order (CONVERTED), declined
// (REJECTED) or withdrawn (CANCELLED). Lines are never edited; a changed offer is a new quotation.
model Quotation {
  id            String    @id
  companyId     String    @map("company_id")
  number        String
  customerId    String    @map("customer_id")
  status        String // OPEN | CONVERTED | REJECTED | CANCELLED
  quotationDate DateTime  @map("quotation_date") @db.Date
  validUntil    DateTime? @map("valid_until") @db.Date
  currency      String
  totalNet      Decimal   @map("total_net") @db.Decimal(19, 4)
  totalTax      Decimal   @map("total_tax") @db.Decimal(19, 4)
  totalGross    Decimal   @map("total_gross") @db.Decimal(19, 4)
  notes         String?
  salesOrderId  String?   @map("sales_order_id")
  createdBy     String    @map("created_by")
  correlationId String    @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company    Company         @relation(fields: [companyId], references: [id])
  customer   Party           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder SalesOrder?     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  lines      QuotationLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("quotations")
}

model QuotationLine {
  id          String  @id
  quotationId String  @map("quotation_id")
  // Null for a service or free-text line.
  itemId      String? @map("item_id")
  description String
  quantity    Decimal @db.Decimal(19, 4)
  unitPrice   Decimal @map("unit_price") @db.Decimal(19, 4)
  taxCodeId   String  @map("tax_code_id")
  taxRate     Decimal @map("tax_rate") @db.Decimal(7, 4)
  netAmount   Decimal @map("net_amount") @db.Decimal(19, 4)
  taxAmount   Decimal @map("tax_amount") @db.Decimal(19, 4)
  lineNumber  Int     @map("line_number")

  quotation Quotation @relation(fields: [quotationId], references: [id])
  item      Item?     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode   TaxCode   @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@map("quotation_lines")
}

// A confirmed order. OPEN -> PARTIALLY_INVOICED -> INVOICED as invoices are raised against it.
model SalesOrder {
  id            String   @id
  companyId     String   @map("company_id")
  number        String
  customerId    String   @map("customer_id")
  status        String // OPEN | PARTIALLY_INVOICED | INVOICED | CANCELLED
  orderDate     DateTime @map("order_date") @db.Date
  currency      String
  totalNet      Decimal  @map("total_net") @db.Decimal(19, 4)
  totalTax      Decimal  @map("total_tax") @db.Decimal(19, 4)
  totalGross    Decimal  @map("total_gross") @db.Decimal(19, 4)
  notes         String?
  createdBy     String   @map("created_by")
  correlationId String   @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  version       Int      @default(1)

  company       Company          @relation(fields: [companyId], references: [id])
  customer      Party            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines         SalesOrderLine[]
  quotations    Quotation[]
  salesInvoices SalesInvoice[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("sales_orders")
}

// invoicedQuantity is the only mutable column; the database backstops 0 <= invoiced <= ordered.
model SalesOrderLine {
  id               String  @id
  salesOrderId     String  @map("sales_order_id")
  itemId           String? @map("item_id")
  description      String
  quantity         Decimal @db.Decimal(19, 4)
  unitPrice        Decimal @map("unit_price") @db.Decimal(19, 4)
  taxCodeId        String  @map("tax_code_id")
  invoicedQuantity Decimal @default(0) @map("invoiced_quantity") @db.Decimal(19, 4)
  lineNumber       Int     @map("line_number")

  salesOrder   SalesOrder         @relation(fields: [salesOrderId], references: [id])
  item         Item?              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode      TaxCode            @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  invoiceLines SalesInvoiceLine[]

  @@index([salesOrderId])
  @@map("sales_order_lines")
}

// A posted sales document: an INVOICE, or a CREDIT_NOTE against one. Amounts are always positive;
// the document type gives the direction. Immutable like a journal entry — a mistake is corrected by
// a credit note, never an edit.
model SalesInvoice {
  id                String    @id
  companyId         String    @map("company_id")
  documentType      String    @map("document_type") // INVOICE | CREDIT_NOTE
  number            String
  customerId        String    @map("customer_id")
  salesOrderId      String?   @map("sales_order_id")
  // CREDIT_NOTE only: the invoice it reduces.
  originalInvoiceId String?   @map("original_invoice_id")
  invoiceDate       DateTime  @map("invoice_date") @db.Date
  dueDate           DateTime? @map("due_date") @db.Date
  currency          String
  totalNet          Decimal   @map("total_net") @db.Decimal(19, 4)
  totalTax          Decimal   @map("total_tax") @db.Decimal(19, 4)
  totalGross        Decimal   @map("total_gross") @db.Decimal(19, 4)
  // Cost of the stock sold (invoices only); what COGS was debited with.
  totalCost         Decimal   @default(0) @map("total_cost") @db.Decimal(19, 4)
  journalEntryId    String    @map("journal_entry_id")
  notes             String?
  actorId           String    @map("actor_id")
  correlationId     String    @map("correlation_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  company         Company            @relation(fields: [companyId], references: [id])
  customer        Party              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder      SalesOrder?        @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  originalInvoice SalesInvoice?      @relation("CreditNotes", fields: [originalInvoiceId], references: [id], onDelete: Restrict)
  creditNotes     SalesInvoice[]     @relation("CreditNotes")
  journalEntry    JournalEntry       @relation(fields: [journalEntryId], references: [id])
  lines           SalesInvoiceLine[]

  @@unique([companyId, number])
  @@index([companyId, customerId])
  @@index([companyId, documentType])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id               String  @id
  salesInvoiceId   String  @map("sales_invoice_id")
  salesOrderLineId String? @map("sales_order_line_id")
  // Stock item sold from a warehouse; both null for a service line.
  itemId           String? @map("item_id")
  warehouseId      String? @map("warehouse_id")
  description      String
  quantity         Decimal @db.Decimal(19, 4)
  unitPrice        Decimal @map("unit_price") @db.Decimal(19, 4)
  netAmount        Decimal @map("net_amount") @db.Decimal(19, 4)
  taxCodeId        String  @map("tax_code_id")
  taxRate          Decimal @map("tax_rate") @db.Decimal(7, 4)
  taxAmount        Decimal @map("tax_amount") @db.Decimal(19, 4)
  // Weighted-average cost taken out of stock for this line (stock lines only), stored at posting
  // time and never recomputed (docs/04 §2).
  costValue        Decimal @default(0) @map("cost_value") @db.Decimal(19, 4)
  // A line may be posted to its own revenue account instead of the mapped default.
  revenueAccountId String? @map("revenue_account_id")
  lineNumber       Int     @map("line_number")

  salesInvoice   SalesInvoice    @relation(fields: [salesInvoiceId], references: [id])
  salesOrderLine SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  item           Item?           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse      Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  taxCode        TaxCode         @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)

  @@index([salesInvoiceId])
  @@map("sales_invoice_lines")
}

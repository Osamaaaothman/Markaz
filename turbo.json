{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      // Without this, a genuinely fresh checkout (CI's `npm ci` + immediately
      // `npm run lint`, nothing built yet) lints a package before its @erp/*
      // dependencies have a dist/ to resolve types against — ESLint's type-aware
      // rules then silently degrade to `any` instead of erroring, and everything
      // downstream of that `any` gets flagged as unsafe. `typecheck` already had
      // this; `lint` didn't, and a local run always had a stale dist/ around from
      // an earlier manual build, which is exactly how this stayed invisible until
      // a real CI run on a clean checkout caught it.
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      // Integration tests (packages/core's ledger-integrity spec) behave differently
      // depending on whether a real database is reachable — without declaring these,
      // Turbo doesn't know DATABASE_URL affects the result and can silently replay a
      // stale cached run (e.g. "skipped" from an earlier run with no DB) even when
      // the database is now available. Caching a DB-dependent test's result at all is
      // borderline; at minimum the cache key must include what it actually depends on.
      "env": ["DATABASE_URL", "MIGRATE_DATABASE_URL"]
    }
  }
}
